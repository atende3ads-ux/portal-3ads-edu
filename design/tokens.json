{
  "$schema": "https://design-tokens.org/schema.json",
  "$description": "Portal 3ADS EDU — tokens de design da Fase 0. Espelha design/tokens.css para consumo programatico (Tailwind, TS, Figma). Auditado contra WCAG AA.",
  "brand": {
    "blue500": { "value": "#007cff", "comment": "Azul 3ADS — identidade e preenchimentos grandes" },
    "blue600": { "value": "#0072eb", "comment": "Botao primario — 4.56:1 com texto branco" },
    "blue700": { "value": "#0068d6", "comment": "Texto azul no tema claro — 4.58:1" }
  },
  "color": {
    "light": {
      "bg": "#f4f5f8",
      "surface": "#ffffff",
      "surface2": "#eceef2",
      "hover": "#f7f9fc",
      "line": "#dde0e6",
      "bluewash": "#e7f2ff",
      "ink": "#0a0b0e",
      "muted": "#656a73",
      "soft": "#666c76",
      "onAccent": "#ffffff",
      "accent": "#007cff",
      "accentStrong": "#0072eb",
      "accentText": "#0068d6",
      "positive": "#10795d",
      "neutral": "#0068d6",
      "warning": "#a15808",
      "danger": "#be3838"
    },
    "dark": {
      "bg": "#030305",
      "surface": "#0d0f13",
      "surface2": "#171a20",
      "hover": "#13161c",
      "line": "#242832",
      "bluewash": "#081d36",
      "ink": "#f7f8fa",
      "muted": "#a4aab4",
      "soft": "#7c828d",
      "onAccent": "#ffffff",
      "accent": "#007cff",
      "accentStrong": "#0072eb",
      "accentText": "#057fff",
      "positive": "#139472",
      "neutral": "#057fff",
      "warning": "#c36b09",
      "danger": "#d05e5e"
    }
  },
  "font": {
    "sans": "\"Geist\", \"Inter\", \"Helvetica Neue\", system-ui, -apple-system, sans-serif",
    "mono": "ui-monospace, \"SF Mono\", \"Cascadia Mono\", Menlo, monospace"
  },
  "fontSize": {
    "micro": "11px",
    "body": "12px",
    "strong": "14px",
    "h3": "16px",
    "h2": "20px",
    "stat": "24px",
    "metric": "26px",
    "h1": "clamp(30px, 3vw, 40px)",
    "display": "clamp(36px, 4vw, 46px)"
  },
  "lineHeight": { "tight": 1.25, "body": 1.5, "loose": 1.6 },
  "letterSpacing": { "eyebrow": "0.14em", "h1": "-0.045em", "display": "-0.055em" },
  "space": {
    "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px",
    "6": "24px", "8": "32px", "10": "40px", "12": "48px", "16": "64px"
  },
  "radius": { "sm": "6px", "md": "8px", "lg": "10px", "xl": "14px", "full": "999px" },
  "shadow": {
    "light": {
      "sm": "0 5px 16px rgba(17, 24, 39, .06)",
      "md": "0 16px 45px rgba(17, 24, 39, .08)",
      "lg": "0 20px 60px rgba(17, 24, 39, .14)"
    },
    "dark": {
      "sm": "0 5px 16px rgba(0, 0, 0, .45)",
      "md": "0 16px 45px rgba(0, 0, 0, .45)",
      "lg": "0 20px 60px rgba(0, 0, 0, .55)"
    }
  },
  "layout": {
    "sidebarWidth": "224px",
    "sidebarWidthCollapsed": "72px",
    "topbarHeight": "58px",
    "contentMax": "1280px",
    "touchMin": "40px"
  },
  "breakpoint": { "sm": "480px", "md": "768px", "lg": "1024px", "xl": "1280px" },
  "motion": {
    "ease": "cubic-bezier(.2, .8, .2, 1)",
    "durationFast": "150ms",
    "durationBase": "220ms",
    "durationSlow": "280ms"
  },
  "zIndex": {
    "topbar": 15, "sidebar": 20, "scrim": 30,
    "drawer": 31, "toast": 50, "modal": 100
  }
}
